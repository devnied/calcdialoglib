<resources xmlns:tools="http://schemas.android.com/tools" tools:ignore="PrivateResource">

    <!-- To customize calculator dialog's style -->
    <style name="CustomCalcDialogStyle" parent="CalcDialogStyle">
<!--        <item name="calcNumberBtnStyle">@style/CustomNumberBtnStyle</item>-->
    </style>

    <style name="CustomNumberBtnStyle" parent="CalcNumberBtnStyle">
        <item name="android:textSize">18sp</item>
    </style>

    <!-- DEMO APP STYLES -->
    <style name="OptionsCardViewStyle" parent="Widget.Material3.CardView.Elevated">
        <item name="android:layout_marginTop">8dp</item>
        <item name="android:layout_marginBottom">8dp</item>
        <item name="android:layout_marginStart">16dp</item>
        <item name="android:layout_marginLeft">16dp</item>
        <item name="android:layout_marginEnd">16dp</item>
        <item name="android:layout_marginRight">16dp</item>
        <item name="cardElevation">3dp</item>
    </style>

    <style name="SubtitleTextViewStyle">
        <item name="android:textAppearance">?attr/textAppearanceTitleSmall</item>
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="OptionsCheckboxStyle" parent="Widget.Material3.CompoundButton.CheckBox">
        <item name="android:minHeight">0dp</item>
        <item name="android:padding">0dp</item>
        <item name="android:textAppearance">?attr/textAppearanceBodyMedium</item>
    </style>

    <style name="DropdownLayoutStyle" parent="Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu">
        <item name="boxBackgroundColor">@color/mtrl_filled_background_color</item>
        <item name="boxStrokeWidth">0dp</item>
        <item name="boxStrokeWidthFocused">0dp</item>
        <item name="hintEnabled">false</item>
    </style>

    <style name="DropdownStyle">
        <item name="android:textAppearance">?attr/textAppearanceBodyMedium</item>
        <item name="boxStrokeColor">@null</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
        <item name="android:inputType">none|textNoSuggestions</item>
        <item name="android:imeOptions">flagNoExtractUi</item>
        <item name="android:focusable">false</item>
        <item name="android:focusableInTouchMode">false</item>
        <item name="android:cursorVisible">false</item>
    </style>

    <style name="InputLayoutStyle" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxBackgroundColor">@color/mtrl_filled_background_color</item>
        <item name="boxStrokeWidth">0dp</item>
        <item name="boxStrokeWidthFocused">0dp</item>
        <item name="hintEnabled">false</item>
    </style>

    <style name="InputStyle">
        <item name="android:textAppearance">?attr/textAppearanceBodyMedium</item>
        <item name="boxStrokeColor">@null</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
        <item name="android:imeOptions">flagNoExtractUi|actionDone</item>
    </style>

</resources>
